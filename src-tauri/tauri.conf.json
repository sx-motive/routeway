{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Routeway",
  "version": "0.2.0",
  "identifier": "com.github.sxmotive.routeway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Routeway",
        "width": 920,
        "height": 700,
        "minWidth": 520,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "resizable": true,
        "backgroundColor": [
          10,
          10,
          11,
          255
        ]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/sing-box"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sx-motive/routeway/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2N0NDM0E3QUNDOTIzRTIKUldUaUk4bXNwOE44VmdlSVYrWmw0VU9hQVV6ZkhYb21RMkVmSzNsUFJRQWlZbEVWcGk0NktTNUsK"
    }
  }
}
